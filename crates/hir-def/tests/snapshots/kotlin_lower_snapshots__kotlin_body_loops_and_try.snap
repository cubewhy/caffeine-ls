SOURCE:

fun scan(items: List<Int>): Int {
    var total = 0
    for (item in items) {
        total += item
    }
    while (total > 100) {
        total -= 1
    }
    do {
        total += 1
    } while (total < 0)
    try {
        total = risky(total)
    } catch (e: IllegalStateException) {
        total = 0
    } finally {
        println(total)
    }
    return total
}

