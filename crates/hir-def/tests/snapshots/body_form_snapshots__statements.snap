class Foo {
    void m() {
        ; // empty
        int a = 1;
        long b = 2L, c = 3L;
        String s = "x";
        foo();
        a++;
        ++a;
        --a;
        a--;
        a += 2;
        a -= 1;
        if (a > 0) { a = 0; } else { a = 1; }
        while (a < 10) { a++; }
        do { a--; } while (a > 0);
        for (int i = 0; i < 3; i++) { a += i; }
        for (int x : new int[] { 1, 2 }) { a += x; }
        switch (a) {
            case 0: a = 1; break;
            case 1: a = 2; break;
            default: a = 0;
        }
        switch (a) {
            case 0 -> a = 1;
            case 1 -> { a = 2; }
            default -> throw new RuntimeException();
        }
        return;
    }
    int v(int x) {
        if (x) throw new RuntimeException();
        return x + 1;
    }
}

