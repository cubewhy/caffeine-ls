fun local(): Int {
    class Counter(val start: Int) {
        fun next(): Int = start + 1
    }

    fun twice(value: Int): Int = value * 2

    val anonymous = object : Runnable {
        override fun run() {}
    }

    return twice(Counter(1).next())
}

