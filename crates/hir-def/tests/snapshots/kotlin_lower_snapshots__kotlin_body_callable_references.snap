class Holder(val items: List<Int>) {
    fun size(): Int = 1

    fun use(): Int {
        val a = items::size
        val b = this::use
        val c = ::topLevel
        val d = Holder::class
        val e = String::class.java
        return a() + b() + c() + d.hashCode() + e.hashCode()
    }
}

