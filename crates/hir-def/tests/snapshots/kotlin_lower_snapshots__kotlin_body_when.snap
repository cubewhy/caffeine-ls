SOURCE:

fun classify(value: Any): String {
    when (value) {
        1 -> return "one"
        in 2..9 -> return "small"
        is String -> return value
        else -> return "other"
    }
}

fun exhaustive(value: Int): String = when (value) {
    0 -> "zero"
    else -> "many"
}

