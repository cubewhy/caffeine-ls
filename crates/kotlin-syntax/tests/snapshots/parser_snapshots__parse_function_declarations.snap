SOURCE:
fun add(a: Int, b: Int): Int = a + b

fun greet(name: String = "world"): String {
    return "Hello, $name"
}

suspend fun fetch(): List<String> = emptyList()

fun <T> List<T>.second(): T? = getOrNull(1)

fun <T> containsIf(where: (T) -> Boolean): Boolean where T : Comparable<T>

