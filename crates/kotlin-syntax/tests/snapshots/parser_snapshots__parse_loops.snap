SOURCE:
fun main() {
    for (i in 1..10) {
        println(i)
    }
    for ((k, v) in map) {
        println("$k=$v")
    }
    var x = 0
    while (x < 10) {
        x++
    }
    do {
        x--
    } while (x > 0)
}

