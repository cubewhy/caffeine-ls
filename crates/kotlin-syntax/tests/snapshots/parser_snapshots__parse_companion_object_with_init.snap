SOURCE:
class Factory {
    companion object {
        const val DEFAULT = 1
    }

    init {
        println("init")
    }

    constructor(size: Int) : this(size, 0)

    var count: Int = 0
        private set

    val total: Int
        get() = count + 1

    fun onEach(block: (Int) -> Unit) {
        for (i in 0..count) block(i)
    }
}

