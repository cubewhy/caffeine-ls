SOURCE:
fun f(a: Int, arr: IntArray, p: P, flag: Boolean) {
    this.field = 1
    p.field = 1
    arr[0] = 1
    (p).field = 1
    p!!.field = 1
    make().field = 1
    !flag += 1
    a!! += 1
}

