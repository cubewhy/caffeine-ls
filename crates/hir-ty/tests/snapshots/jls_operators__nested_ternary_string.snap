package com.example;

class Body {
    String marker(boolean a, boolean c) {
        return a ? "+ " : c ? "~ " : "  ";
    }

    int nested(byte marker) {
        return marker == 3 ? 3 : marker == 2 ? 2 : marker == 1 ? 1 : 0;
    }
}

