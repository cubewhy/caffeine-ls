package com.example;

import java.io.Closeable;
import java.io.IOException;

class Resource implements Closeable {
    public void close() {}
    int read() { return 1; }
}

class Body {
    int risky() throws IOException { return 1; }

    int m(Resource r) {
        int acc = 0;
        try {
            acc += risky();
        } catch (IOException e) {
            acc = -1;
        } finally {
            acc += 2;
        }
        try (Resource r2 = new Resource(); Resource r3 = new Resource()) {
            acc += r2.read();
        }
        return acc;
    }
}

