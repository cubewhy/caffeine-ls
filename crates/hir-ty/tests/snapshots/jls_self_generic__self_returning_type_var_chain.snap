package com.example;

class G {
    interface Box<T extends Box<T>> {
        T self();

        T reset();

        int size();
    }

    static <T extends Box<T>> T rebuild(T input) {
        return input.self().reset().self();
    }

    static <T extends Box<T>> int depth(T input) {
        return input.self().self().size();
    }
}

