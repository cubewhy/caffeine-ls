package com.example;

class Body {
    int m(int kind, java.util.List<String> out) {
        String start;
        java.util.List<String> picked = switch (kind) {
            case 1 -> {
                start = "one";
                yield out;
            }
            default -> {
                start = "rest";
                yield out;
            }
        };
        return start.length() + picked.size();
    }
}

