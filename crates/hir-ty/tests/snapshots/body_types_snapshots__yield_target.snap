package com.example;

class Body {
    <T> T id(T x) {
        return x;
    }

    int m(int b) {
        String s = switch (b) {
            case 1 -> "a";
            default -> { yield id("b"); }
        };
        int n = switch (b) {
            case 1 -> 1;
            default -> { yield 2; }
        };
        return s.length() + n;
    }
}

