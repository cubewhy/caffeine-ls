package com.example;

class Body {
    byte m(byte b, short s, int i, long lo) {
        b += 1;
        b -= 1;
        s *= 2;
        s /= 2;
        i %= 3;
        i <<= 2;
        i >>= 1;
        i >>>= 1;
        i &= 0x0F;
        i |= 0xF0;
        i ^= 0xFF;
        lo += i;
        return b;
    }
}

