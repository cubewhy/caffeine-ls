package com.example;

class Body {
    long m(byte a, short b, char c, int i, long lo, float f, double d, java.lang.Integer box) {
        long l1 = a + b;
        long l2 = i + lo;
        double d1 = i + d;
        float f1 = b + f;
        int i1 = a * b;
        int i2 = i / b;
        int rem = a % b;
        long b1 = lo - i;
        int bi = box + i;
        long bl = box + lo;
        return l1 + l2 + i1 + i2 + rem + (long) b1 + (long) bi + (long) bl;
    }
}

