package com.example;

enum Side {
    OLD {
        @Override boolean matches(int n) { return n < 0; }

        int cached = helper();

        void local() { helper(); }
    },
    NEW {
        @Override boolean matches(int n) { return true; }
    };

    abstract boolean matches(int n);

    static int helper() { return 1; }
}
