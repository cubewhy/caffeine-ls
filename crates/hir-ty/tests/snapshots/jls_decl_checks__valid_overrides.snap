package com.example;

class Base {
    Base self() { return this; }
}

class Derived extends Base {
    Derived self() { return this; }
}

interface A {
    default String name() { return "a"; }
}

interface B {
    default String name() { return "b"; }
}

class Diamond implements A, B {
    public String name() { return "c"; }
}
