package com.example;

import java.util.Collections;
import java.util.List;

class Body {
    <T> List<T> wrap(List<T> xs) {
        return xs;
    }

    <T> T id(T x) {
        return x;
    }

    void call() {
        List<String> ys = wrap(id(Collections.emptyList()));
    }
}

