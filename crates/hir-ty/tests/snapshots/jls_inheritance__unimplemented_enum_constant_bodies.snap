package com.example;

class DiffNode {}

enum TreeSide {
    OLD {
        @Override boolean matches(DiffNode node) { return true; }
    },
    NEW {
        @Override boolean matches(DiffNode node) { return false; }
    };
    abstract boolean matches(DiffNode node);
}
