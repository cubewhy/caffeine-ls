package com.example;

import java.util.List;

class Body {
    int forEach(List<String> xs, java.lang.Iterable<Integer> ys, String[] as, int[] ns) {
        int sum = 0;
        for (String x : xs) {
            sum += x.length();
        }
        for (Integer y : ys) {
            sum += y;
        }
        for (String a : as) {
            sum += a.length();
        }
        for (int n : ns) {
            sum += n;
        }
        return sum;
    }
}

