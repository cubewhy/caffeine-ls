package com.example;

class Body {
    int m(byte b, short s, char c, java.lang.Integer box, int i) {
        int pos = +b;
        int neg = -i;
        int negB = -box;
        int not = ~b;
        int inc = ++i;
        int dec = b-- - ++c;
        int unboxed = -new java.lang.Integer(3);
        return pos + neg + not + inc + dec + unboxed + negB;
    }
}

