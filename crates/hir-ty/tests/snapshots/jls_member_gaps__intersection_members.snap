package com.example;

class Body {
    interface Mapped {}

    interface Copyable<T extends Mapped> {
        T copy(String s);
    }

    interface Decoder<T> {
        T decode(String s);
    }

    static <T extends Mapped & Copyable<T>> void test(Decoder<T> d) {
        d.decode("x").copy("y");
    }
}

