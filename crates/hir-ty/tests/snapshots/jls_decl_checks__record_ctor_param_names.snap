package com.example;

record R1(int x) {
    R1(int z) {
        this.x = z;
    }
}

record R2(int x, String s) {
    R2(int a, String b) {
        this.x = a;
        this.s = b;
    }
}

record R3(int x) {
    R3(int x) {
        this.x = x;
    }
}

record R5(int x) {
    R5(int x, int extra) {
        this(x);
    }
}

