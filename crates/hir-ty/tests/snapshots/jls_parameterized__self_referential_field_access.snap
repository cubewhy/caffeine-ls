package com.example;

class Box<K, T extends Box<K, T>> {
    private Box<K, T> inner;

    Box<K, T> get() {
        return this.inner;
    }

    void set(Box<K, T> value) {
        this.inner = value;
    }

    void combine(Box<K, T> value) {
        Box<K, T> local = this.get();
        this.set(local);
        this.set(value);
    }
}

