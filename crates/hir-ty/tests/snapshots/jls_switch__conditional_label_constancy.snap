package com.example;

class Sw {
    void m(int i) {
        final boolean flag = true & false;
        final int x = i;
        switch (i) {
            case false ? x : 2 -> f(0);
            case flag ? 1 : 2 -> f(1);
            case 2 -> f(1);
            default -> {}
        }
    }

    void f(int x) {}
}

