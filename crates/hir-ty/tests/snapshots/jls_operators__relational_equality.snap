package com.example;

class Body {
    boolean m(int i, long lo, double d, java.lang.Integer box, java.lang.String s, Object o, int[] arr) {
        boolean lt = i < lo;
        boolean gt = d > i;
        boolean le = i <= 1;
        boolean ge = box >= 1;
        boolean eq = i == 1L;
        boolean ne = box != lo;
        boolean ref = s == "x";
        boolean obj = o == s;
        boolean nullEq = s == null;
        boolean nulNe = null != arr;
        boolean unbox = box == i;
        return lt && gt && le && ge && eq && ne && ref && obj && nullEq && nulNe && unbox;
    }
}

