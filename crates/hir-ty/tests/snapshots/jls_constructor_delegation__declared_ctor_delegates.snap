package com.example;

class NeedsArg {
    NeedsArg() {}
    NeedsArg(int x) {}
}

class Sub extends NeedsArg {
    Sub(int x) {
        super(x);
    }
    Sub() {
        this(1);
    }
}

class Chain extends NeedsArg {
    Chain() {
        super();
    }
}
