package com.example;

class Lambda {
    interface IntMaker { int make(); }

    void go() {
        int n = first(() -> {
            side();
            return 1;
        });
        after(n);
    }

    int first(IntMaker maker) { return maker.make(); }
    void side() { }
    void after(int n) { }
}

