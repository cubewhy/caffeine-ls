package com.example;

import java.util.function.Supplier;

interface I {
    static String s() {
        return "";
    }
}

interface J extends I {}

class C implements I {}

class Body {
    String own(I i) {
        return I.s();
    }

    Supplier<String> ref() {
        return I::s;
    }

    String subinterface(J j) {
        return J.s();
    }

    Supplier<String> subinterfaceRef() {
        return J::s;
    }

    String implementing(C c) {
        return C.s();
    }
}

