package com.example;

import java.lang.annotation.ElementType;
import java.lang.annotation.Target;

@Target({ ElementType.TYPE, ElementType.METHOD, ElementType.FIELD })
@interface M {}

@M
class Anns {
    @M
    void run() {}

    @M
    int x;
}
