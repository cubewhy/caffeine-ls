    interface FloatModifier<A> extends Base<Float, A> {}

    interface Simple extends FloatModifier<Float> {
        default NbtCodec<Float> codec(Env<Float> attribute) {
            return null;
        }
    }

    static void m() {
        Simple s1 = (a, b) -> a - b;
        FloatModifier<Float> m1 = (Simple) Float::sum;
    }
}

