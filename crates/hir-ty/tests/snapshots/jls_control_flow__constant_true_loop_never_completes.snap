FILE /src/com/example/NoRet.java:
package com.example;

class NoRet {
    int whileTrue(boolean a) {
        while (true) {
            if (a) {
                return 1;
            }
            throw new RuntimeException();
        }
    }

    int forEver(boolean a) {
        for (;;) {
            if (a) {
                return 2;
            }
        }
    }

    int doWhileTrue(boolean a) {
        do {
            if (a) {
                return 3;
            }
        } while (true);
    }
}

