    boolean notBad() { return !1; }
    boolean eqBad() { return 1 == s; }
    boolean ltBad() { return 1 < s; }
    boolean boolAndBad() { return true && 1; }
    boolean boolOrBad() { return false || 1; }
    int castBad() { return (int) s; }
    int mulBad() { return 2 * s; }
}

