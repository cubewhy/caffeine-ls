package com.example;

class Body {
    int count = 10;
    static Body singleton = new Body();

    int run(int[] values, int index) {
        int acc = 0;
        for (int i = 0; i < values.length; i++) {
            acc = acc + values[i];
        }
        return acc + this.count;
    }

    int arrays() {
        int[][] grid = new int[3][4];
        int[] row = grid[1];
        int[] init = { 1, 2, 3 };
        return init[0] + row[1];
    }

    int conditional(int x) {
        return x > 0 ? x : -x;
    }
}

