package com.example;

import static org.example.assertions.A.assertThat;

import java.util.ArrayList;
import java.util.List;

class Body {
    void check(List<String> names) {
        assertThat(names).hasSize(3);
        assertThat(names.size()).isEqualTo(3);
        int count = 10;
        assertThat(count);
    }
}

