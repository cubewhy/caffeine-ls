package com.example;

class Sw {
    void m(String s) {
        switch (s) {
            case "\101" -> f();
            case "A" -> f();
            case "a\sb" -> f();
            case "a b" -> f();
            case """
                B
                """ -> f();
            case "B\n" -> f();
            case "a" + 1 -> f();
            default -> {}
        }
    }

    void f() {}
}

