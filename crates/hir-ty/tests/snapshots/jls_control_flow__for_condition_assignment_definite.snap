package com.example;

class Body {
    void m(String s) {
        char c;
        int i = 0;
        for (; i < s.length() && (c = s.charAt(i)) != '\u0000'; i++) {
            System.out.println(c);
        }
        if (c == '\u0000') {
            return;
        }
    }
}

