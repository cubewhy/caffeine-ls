package com.example;

class Body {
    int identity(int x) {
        return x;
    }

    String concat(String a, String b) {
        return a + b;
    }

    int call() {
        int x = identity(7);
        String s = concat("a", "b");
        int len = s.length();
        Body other = new Body();
        int y = other.identity(x);
        return y;
    }
}

