package com.example;

@interface Ann {
    Class<?> c();
}

class Anns {
    static final Class<?> THIS_TYPE = String.class;

    @Ann(c = String.class)
    @Ann(c = (String.class))
    @Ann(c = THIS_TYPE)
    void run() {}
}

