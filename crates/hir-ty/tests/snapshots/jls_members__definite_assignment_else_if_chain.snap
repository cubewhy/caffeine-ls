package com.example;

import java.io.IOException;

class Parse {
    int css(String arg) throws IOException {
        final int step, offset;
        if (arg.length() == 3) {
            step = 2;
            offset = 1;
        } else {
            if (arg.length() == 4) {
                step = 5;
                offset = 0;
            } else if (arg.length() > 2) {
                step = 0;
                offset = 1;
            } else {
                throw new IOException("bad");
            }
        }
        return step + offset;
    }
}

