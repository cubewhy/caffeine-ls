FILE /src/com/example/Base.java:
package com.example;

public class Base {
    public enum Mode { ON, OFF }
}

FILE /src/com/example/Derived.java:
package com.example;

public class Derived extends Base {
    int use(Derived d) {
        Mode m = Mode.ON;
        if (d == null) {
            m = Base.Mode.OFF;
        }
        return m == Mode.ON ? 1 : 0;
    }
}

