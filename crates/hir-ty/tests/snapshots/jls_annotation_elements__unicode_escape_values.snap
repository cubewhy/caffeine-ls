package com.example;

@interface ByteAnn {
    byte b();
}

@interface CharAnn {
    char c();
}

@interface StringAnn {
    String s();
}

@ByteAnn(b = '\u007f')
@ByteAnn(b = '\u00ff')
@CharAnn(c = '\u0061')
@StringAnn(s = "\u0041")
@StringAnn(s = "\u005Cn")
class Anns {}

