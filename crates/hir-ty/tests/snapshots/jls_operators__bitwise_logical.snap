package com.example;

class Body {
    int m(int a, int b, boolean x, boolean y, java.lang.Boolean bx) {
        int band = a & b;
        int bor = a | b;
        int bxor = a ^ b;
        boolean land = x & y;
        boolean lor = x | y;
        boolean lxor = x ^ y;
        boolean and = x && bx;
        boolean or = !x || y;
        return band + bor + bxor + (land ? 1 : 0) + (lor ? 1 : 0) + (lxor ? 1 : 0);
    }
}

