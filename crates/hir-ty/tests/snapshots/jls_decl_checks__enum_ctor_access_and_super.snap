package com.example;

enum Seasons {
    SPRING, SUMMER;

    Seasons() {}

    public Seasons(int x) {}

    protected Seasons(int x, int y) {}

    private Seasons(int x, int y, int z) {}
}

enum Wrong {
    BAD;

    Wrong() {
        super();
    }
}

enum Good {
    OK;

    Good() {}
    Good(int x) {
        this();
    }
}

