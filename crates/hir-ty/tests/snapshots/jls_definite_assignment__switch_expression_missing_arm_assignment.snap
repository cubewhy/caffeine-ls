package com.example;

class Body {
    int m(int kind, java.util.List<String> out) {
        String start;
        int len = switch (kind) {
            case 1 -> {
                start = "one";
                yield out.size();
            }
            default -> out.size();
        };
        return start.length() + len;
    }
}

