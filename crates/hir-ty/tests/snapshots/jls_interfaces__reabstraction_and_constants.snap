package com.example;

interface A {
    default String name() { return "a"; }
    int MAX = 10;
}

interface B extends A {
    String name();
}

class C implements B {
    public String name() { return "c" + MAX; }

    int useMax() {
        return B.MAX + C.this.MAX;
    }
}

