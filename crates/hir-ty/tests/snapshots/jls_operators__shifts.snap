package com.example;

class Body {
    int m(byte b, short s, char c, long lo, java.lang.Integer box) {
        int shl = b << 2;
        int shr = s >> 1;
        int ushr = c >>> 1;
        long lsh = lo << 3;
        int boxed = box << 2;
        return shl + shr + ushr + (int) lsh + boxed;
    }
}

