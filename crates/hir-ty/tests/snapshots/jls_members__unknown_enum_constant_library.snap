package com.example;

import com.lib.Syntax;

class Use {
    boolean isHtml(Syntax syntax) {
        return syntax == Syntax.xml;
    }

    Syntax ok(Syntax syntax) {
        return Syntax.html;
    }

    Syntax bad(Syntax syntax) {
        return Syntax.json;
    }
}

