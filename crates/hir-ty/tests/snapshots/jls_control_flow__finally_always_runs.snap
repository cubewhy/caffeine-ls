FILE /src/com/example/Body.java:
package com.example;

import java.io.IOException;

class Body {
    static class Guard {
        void lock() {}
        void unlock() {}
    }

    void run(Guard lock) throws IOException {
        boolean acquired = false;
        lock.lock();
        try {
            acquired = true;
        } catch (RuntimeException exception) {
            if (acquired) {
                lock.unlock();
            }
            throw new IOException("Interrupted", exception);
        } finally {
            if (acquired) {
                lock.unlock();
            }
        }
    }
}

