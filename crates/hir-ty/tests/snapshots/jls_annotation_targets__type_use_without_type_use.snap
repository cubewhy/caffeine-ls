package com.example;

import java.lang.annotation.ElementType;
import java.lang.annotation.Target;

@Target(ElementType.METHOD)
@interface M {}

@Target(ElementType.TYPE_USE)
@interface T {}

class Anns {
    @M String field;
    @T String ok;
}

@12:5: annotation-not-applicable: Annotation '@M' is not applicable to 'FIELD'
