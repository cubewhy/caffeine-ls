package com.example;

class Capture {
    static class Row {
        Runnable removeCallback;
    }

    void m(Row row, boolean content) {
        Runnable runnable;
        if (content && (runnable = row.removeCallback) != null) {
            new Thread(() -> System.out.println(runnable)).start();
        }
    }
}

